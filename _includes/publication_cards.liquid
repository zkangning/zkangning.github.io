{% assign publications = site.data.publications | sort: 'order' %}
{% assign area_heading = include.area_heading | default: 'h2' %}
{% assign paper_heading = 'h3' %}
{% if area_heading == 'h3' %}{% assign paper_heading = 'h4' %}{% endif %}
<div class="research-publications">
  <nav class="research-index" id="publication-index" aria-label="Publication research areas">
    <p class="research-index-label">Research directions</p>
    <ul>
      {% for area in site.data.research_areas %}
        <li>
          <a href="#{{ area.id }}">
            <span>{{ area.nav_title }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
    <p class="research-index-key"><span aria-hidden="true"></span> First / co-first author</p>
  </nav>

  <div class="research-sections">
    <div class="publication-note">
      <p><sup>*</sup> Equal contribution. First/co-first-author papers are highlighted.</p>
      <p>Scholar citations{% if site.data.google_scholar.updated_at %} updated {{ site.data.google_scholar.updated_at | date: '%b %d, %Y' }}{% endif %}; GitHub stars refresh automatically.</p>
    </div>
    {% for area in site.data.research_areas %}
      {% assign area_papers = publications | where: 'area', area.id %}
      <section class="research-area" id="{{ area.id }}" aria-labelledby="{{ area.id }}-title">
        <header class="research-area-header">
          <div class="research-area-kicker"><span aria-hidden="true">0{{ forloop.index }}</span> {{ area.focus }}</div>
          <div class="research-area-heading">
            <{{ area_heading }} id="{{ area.id }}-title">{{ area.title }}</{{ area_heading }}>
            <span class="research-area-count">{{ area_papers.size }} {% if area_papers.size == 1 %}paper{% else %}papers{% endif %}</span>
          </div>
          <p>{{ area.description }}</p>
        </header>
        <div class="publication-card-list">
          {% for pub in area_papers %}
            {% include publication_card.liquid pub=pub heading=paper_heading %}
          {% endfor %}
        </div>
        <a class="research-back-link" href="#publication-index">Back to research directions <span aria-hidden="true">↑</span></a>
      </section>
    {% endfor %}
  </div>
</div>
